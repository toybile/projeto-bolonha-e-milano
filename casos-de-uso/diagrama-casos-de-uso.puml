@startuml diagrama-casos-de-uso
' Bolonha e Milano - casos de uso (versao final)
' Seta cheia = o jogador usa o caso de uso.
' <<include>> = sempre acontece junto; <<extend>> = opcao dentro do caso maior.

!theme plain
skinparam dpi 150
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #555555
skinparam ArrowThickness 1.2
skinparam TitleFontSize 20
skinparam TitleFontStyle bold
skinparam nodesep 18
skinparam ranksep 70
skinparam actor {
  BorderColor #3C4A5E
  BackgroundColor #EEF2F7
  FontStyle bold
}
skinparam rectangle {
  BorderColor #9AA5B1
  FontColor #3C4A5E
  FontSize 15
  FontStyle bold
  RoundCorner 16
}
skinparam usecase {
  BorderThickness 1.2
  BorderColor #4C51A8
  BackgroundColor #EEF0FB
  FontColor #1F2340
}
skinparam usecase<<Mercado>> {
  BackgroundColor #EAF6EF
  BorderColor #2F7A4F
}
skinparam usecase<<Agricultura>> {
  BackgroundColor #F3F8E6
  BorderColor #6A8F1F
}
skinparam usecase<<Governo>> {
  BackgroundColor #FFF8E7
  BorderColor #B7791F
}
skinparam usecase<<Construcoes>> {
  BackgroundColor #FBEDEA
  BorderColor #A8452F
}
skinparam usecase<<Ano>> {
  BackgroundColor #F3EEFB
  BorderColor #6B4CA8
}
hide stereotype

title Bolonha e Milano - Diagrama de Casos de Uso

left to right direction

actor Jogador

rectangle "Bolonha e Milano" {

  usecase "Iniciar novo jogo" as UC1
  usecase "Ver status da cidade" as UC2
  usecase "Acessar mercado" as UC3
  usecase "Acessar agricultura" as UC4
  usecase "Acessar governo" as UC5
  usecase "Acessar construções" as UC6
  usecase "Encerrar turno" as UC7
  usecase "Ver classificação" as UC8
  usecase "Ver informações\nsobre o jogo" as UC9
  usecase "Sair do jogo" as UC10

  usecase "Comprar grãos" as M1 <<Mercado>>
  usecase "Vender grãos" as M2 <<Mercado>>
  usecase "Comprar terras" as M3 <<Mercado>>
  usecase "Vender terras" as M4 <<Mercado>>

  usecase "Colher a safra" as A1 <<Agricultura>>
  usecase "Distribuir alimentos" as A2 <<Agricultura>>

  usecase "Arrecadar impostos" as G1 <<Governo>>
  usecase "Definir taxa\nde imposto" as G2 <<Governo>>
  usecase "Definir nível\nde justiça" as G3 <<Governo>>

  usecase "Recrutar soldados" as C1 <<Construcoes>>
  usecase "Construir" as C2 <<Construcoes>>

  usecase "Fechar o ano\n(promover títulos)" as T1 <<Ano>>
  usecase "Declarar vencedor" as T2 <<Ano>>
}

Jogador --> UC8
Jogador --> UC9
Jogador --> UC10
Jogador --> UC3
Jogador --> UC4
Jogador --> UC5
Jogador --> UC6
Jogador --> UC7
Jogador --> UC1
Jogador --> UC2

UC3 <.. M1 : <<extend>>
UC3 <.. M2 : <<extend>>
UC3 <.. M3 : <<extend>>
UC3 <.. M4 : <<extend>>

UC4 <.. A1 : <<extend>>
UC4 <.. A2 : <<extend>>

UC5 <.. G1 : <<extend>>
UC5 <.. G2 : <<extend>>
UC5 <.. G3 : <<extend>>

UC6 <.. C1 : <<extend>>
UC6 <.. C2 : <<extend>>

UC7 <.. T1 : <<extend>>\n(só o último jogador)
T1 <.. T2 : <<extend>>\n(Rei/Rainha ou fim de 1410)

UC1 .right.> UC2 : <<include>>

@enduml
