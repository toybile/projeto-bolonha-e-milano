@startuml diagrama-classes
' Bolonha e Milano - diagrama de classes (Etapa 7)
' Notacao: "-" private, "+" public, {static} = da classe.
' Linha cheia com seta = associacao (guarda o objeto como atributo).
' Linha tracejada com seta = dependencia (so usa, recebe como parametro).

title Bolonha e Milano - Diagrama de Classes
skinparam classAttributeIconSize 0
hide empty members

package bolonhaemilano {

class Main {
  + {static} main(args: String[]): void
}

class Menu {
  - {static} CIDADES_PADRAO: String[]
  - scanner: Scanner
  - emExecucao: boolean
  - partida: Partida
  - cidade: Cidade
  - mercado: Mercado
  - agricultura: Agricultura
  - governo: Governo
  - construcoes: Construcoes
  - nobreza: Nobreza
  + Menu()
  + executar(): void
  - exibirOpcoes(): void
  - processarOpcao(opcao: int): void
  - lerOpcao(): int
  - lerQuantidade(): int
  - iniciarNovoJogo(): void
  - exibirStatus(): void
  - abrirMercado(): void
  - comprarGraos() / venderGraos() / comprarTerras() / venderTerras(): void
  - abrirAgricultura(): void
  - colher() / distribuirAlimentos(): void
  - abrirGoverno(): void
  - arrecadarImpostos() / definirTaxaImposto() / definirJustica(): void
  - abrirConstrucoes(): void
  - recrutarSoldados() / construir(): void
  - encerrarTurno(): void
  - exibirClassificacao(): void
  - encerrarPartida(): void
  - exibirSobre(): void
  - descreverDaVez(): String
}

class Partida {
  + {static} MAXIMO_JOGADORES: int = 4
  - {static} ANO_FINAL: int = 1410
  - cidades: List<Cidade>
  - indiceAtual: int
  + adicionarCidade(cidade: Cidade): boolean
  + getCidades(): List<Cidade>
  + getCidadeAtual(): Cidade
  + getAnoAtual(): int
  + getAnoFinal(): int
  + passarTurno(): boolean
  + encerrarAno(nobreza: Nobreza): List<Cidade>
  + terminou(): boolean
  + determinarVencedor(nobreza: Nobreza): Cidade
}

class Cidade {
  - {static} ANO_INICIAL: int = 1400
  - {static} FLORINS_INICIAIS: int = 1000
  - {static} TERRAS_INICIAIS: int = 10000
  - {static} GRAOS_INICIAIS: int = 500
  - {static} SERVOS_INICIAIS: int = 200
  - {static} TAXA_IMPOSTO_INICIAL: int = 10
  - {static} NIVEL_JUSTICA_INICIAL: String = "Moderada"
  - {static} SOLDADOS_INICIAIS: int = 0
  - {static} CONSTRUCOES_INICIAIS: int = 0
  - nome: String
  - anoAtual: int
  - dono: Jogador
  - florins: int
  - terras: int
  - graos: int
  - servos: int
  - taxaImposto: int
  - nivelJustica: String
  - soldados: int
  - construcoes: int
  - colheitaFeita: boolean
  - impostosArrecadados: boolean
  + Cidade(nome: String, dono: Jogador)
  + getNome(): String
  + getAnoAtual(): int
  + getDono(): Jogador
  + avancarAno(): void
  + isColheitaFeita(): boolean
  + marcarColheitaFeita(): void
  + isImpostosArrecadados(): boolean
  + marcarImpostosArrecadados(): void
  + getTaxaImposto(): int / setTaxaImposto(taxa: int): void
  + getNivelJustica(): String / setNivelJustica(nivel: String): void
  + getFlorins(): int
  + adicionarFlorins(quantidade: int): void
  + removerFlorins(quantidade: int): boolean
  + getTerras(): int
  + adicionarTerras(quantidade: int): void
  + removerTerras(quantidade: int): boolean
  + getGraos(): int
  + adicionarGraos(quantidade: int): void
  + removerGraos(quantidade: int): boolean
  + getServos(): int
  + adicionarServos(quantidade: int): void
  + removerServos(quantidade: int): boolean
  + getSoldados(): int
  + adicionarSoldados(quantidade: int): void
  + removerSoldados(quantidade: int): boolean
  + getConstrucoes(): int
  + adicionarConstrucoes(quantidade: int): void
  + removerConstrucoes(quantidade: int): boolean
  + exibirStatus(): void
}

class Jogador {
  - {static} TITULOS: String[]
  - nome: String
  - nivelTitulo: int
  + Jogador(nome: String)
  + getNome(): String
  + getTitulo(): String
  + getNivelTitulo(): int
  + promover(): boolean
  + ehMonarca(): boolean
}

class Mercado {
  - {static} PRECO_GRAO: int = 2
  - {static} PRECO_TERRA: int = 1
  + comprarGraos(cidade: Cidade, quantidade: int): boolean
  + venderGraos(cidade: Cidade, quantidade: int): boolean
  + comprarTerras(cidade: Cidade, quantidade: int): boolean
  + venderTerras(cidade: Cidade, quantidade: int): boolean
}

class Agricultura {
  - {static} HECTARES_POR_SERVO: int = 5
  - {static} RENDIMENTO_POR_HECTARE: int = 2
  - {static} SERVOS_POR_GRAO: int = 5
  - {static} CRESCIMENTO_PERCENTUAL: int = 5
  - {static} PERCENTUAL_MINIMO: int = 20
  - {static} PERCENTUAL_MAXIMO: int = 80
  + processarColheita(cidade: Cidade): int
  + distribuirAlimentos(cidade: Cidade, percentual: int): boolean
}

class Governo {
  - {static} TAXA_MAXIMA: int = 50
  - {static} MULTIPLICADOR_JUSTA: double = 0.8
  - {static} MULTIPLICADOR_MODERADA: double = 1.0
  - {static} MULTIPLICADOR_SEVERA: double = 1.3
  + arrecadarImpostos(cidade: Cidade): int
  + definirTaxaImposto(cidade: Cidade, taxa: int): boolean
  + definirJustica(cidade: Cidade, nivel: String): boolean
  - multiplicadorPara(nivel: String): double
}

class Construcoes {
  - {static} PRECO_SOLDADO: int = 5
  - {static} SERVOS_POR_SOLDADO: int = 1
  - {static} PRECO_CONSTRUCAO: int = 20
  + recrutarSoldados(cidade: Cidade, quantidade: int): boolean
  + construir(cidade: Cidade, quantidade: int): boolean
  + getPrecoSoldado(): int
  + getPrecoConstrucao(): int
}

class Nobreza {
  - {static} PESO_CONSTRUCAO: int = 10
  - {static} PESO_SOLDADO: int = 2
  - {static} PESO_SERVO: int = 1
  - {static} HECTARES_POR_PONTO: int = 100
  - {static} PRESTIGIO_MINIMO: int[] = {0, 400, 550, 700, 850, 1000}
  + calcularPrestigio(cidade: Cidade): int
  + prestigioParaProximoTitulo(jogador: Jogador): int
  + verificarPromocao(cidade: Cidade): boolean
}

}

' ----- associacoes (atributos) -----
Main ..> Menu : cria
Menu --> "0..1" Partida : partida
Menu --> "0..1" Cidade : cidade (vez atual)
Menu --> "1" Mercado
Menu --> "1" Agricultura
Menu --> "1" Governo
Menu --> "1" Construcoes
Menu --> "1" Nobreza
Partida --> "1..4" Cidade : cidades
Cidade --> "1" Jogador : dono

' ----- dependencias (parametros) -----
Mercado ..> Cidade
Agricultura ..> Cidade
Governo ..> Cidade
Construcoes ..> Cidade
Nobreza ..> Cidade
Nobreza ..> Jogador
Partida ..> Nobreza


@enduml
